# Local dev — copy to `.env`
# Production: `sca-client/.env.production` (api.sharifcommerceacademy.com)

NEXT_PUBLIC_API_URL=/api
# Set to true to show skip forward/back buttons and arrow-key skip
NEXT_PUBLIC_VIDEO_SKIP_ENABLED=true
NEXT_PUBLIC_VIDEO_SKIP_SECONDS=5
API_PROXY_TARGET=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000/api
